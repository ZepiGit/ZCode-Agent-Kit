+/**
+ * Encodings the JS runtimes used by local clients auto-decode transparently
+ * (mirrors AUTO_DECODED_ENCODINGS in handler.ts), plus `identity`.
+ */
+const SAFE_ACCEPT_ENCODINGS = new Set(["gzip", "x-gzip", "deflate", "br", "identity"]);
+
+/** Remove encodings the client may advertise but not actually decode (zstd). */
+export function filterAcceptEncoding(header: string): string {
+  const kept: string[] = [];
+  for (const tokenRaw of header.split(",")) {
+    const token = tokenRaw.trim();
+    if (!token) continue;
+    const base = token.split(";")[0].trim().toLowerCase();
+    if (SAFE_ACCEPT_ENCODINGS.has(base)) kept.push(token);
+  }
+  return kept.length > 0 ? kept.join(", ") : "gzip";
+}
