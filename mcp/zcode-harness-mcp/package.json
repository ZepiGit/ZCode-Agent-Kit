{
  "name": "zcode-harness-mcp",
  "version": "0.1.0",
  "description": "MCP bridge that lets external agents drive the real installed ZCode harness (app-server protocol) over MCP.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zcode-harness-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "start:http": "node dist/index.js --http --port 3322 --host 127.0.0.1",
    "test": "npm run build && node --test test/unit/security.test.mjs test/integration/bridge.test.mjs test/integration/robustness.test.mjs test/integration/http-gate.test.mjs",
    "test:live": "npm run build && node --test test/live/live.test.mjs",
    "probe:runtime": "node -e \"import('./dist/discovery.js').then(m=>m.printDiscovery()).then(JSON.stringify).then(console.log)\""
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
